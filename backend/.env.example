# TürkçePrep AI — Backend muhit o'zgaruvchilari
# Bu faylni .env ga ko'chiring va kalitni to'ldiring:  cp .env.example .env

# --- 1-variant (asosiy): Google Gemini ---
# aistudio.google.com → API key
GEMINI_API_KEY=

# --- 2-variant (zaxira): OpenAI-mos API (masalan Freebuff/OpenAI) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
OPENAI_MODEL=gpt-4o-mini

# Geminisha ikkalasi ham bo'lmasa, API tahlil qilmaydi va /api/config da "ai_provider":"none" qaytadi.
